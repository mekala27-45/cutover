FROM python:3.12-slim
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY packages packages
COPY evaluation evaluation
COPY config config
COPY public_results/manifest.json public_results/manifest.json
COPY app.py .
EXPOSE 80
CMD ["uvicorn","app:app","--host","0.0.0.0","--port","80","--no-access-log"]
